<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="QSightClient.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <StackPanel Spacing="20">

            <TextBlock
                Text="Q-Sight Agent Status"
                FontSize="24"
                FontWeight="Bold"/>

            <Border Padding="16" BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" CornerRadius="8">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12">
                        <TextBlock Text="에이전트 상태" FontWeight="SemiBold" FontSize="16"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Agent Status" FontSize="12" Opacity="0.7"/>
                            <TextBlock x:Name="AgentStatusText" Text="Running" FontWeight="Medium"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Current File" FontSize="12" Opacity="0.7"/>
                            <TextBlock x:Name="CurrentFileText" Text="-" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Queue Size" FontSize="12" Opacity="0.7"/>
                            <TextBlock x:Name="QueueSizeText" Text="0"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Last Message"/>
                            <TextBlock x:Name="LastMessageText" Text="-"/>
                        </StackPanel>

                        <ProgressBar
                            x:Name="ScanProgressBar"
                            Minimum="0"
                            Maximum="100"
                            Height="10"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"/>

                        <Button
                            Content="Cancel Scan"
                            Click="CancelScan_Click"
                            Width="120"
                            HorizontalAlignment="Left"/>

                        <Rectangle Height="1.5" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Opacity="0.6" Margin="0,15,0,15"/>

                        <TextBlock Text="추가 분석 필요(Unknown)" FontWeight="SemiBold" FontSize="16"/>
                        <ListView ItemsSource="{x:Bind UnknownFiles}" 
                                      Height="100"
                                      BorderThickness="1"
                                      BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind}" VerticalAlignment="Center"/>
                                        <!--<Button Content="동적 분석 실행" Click="OnRunDynamicAnalysisClick"/>-->
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Rectangle Height="1.5" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Opacity="0.6" Margin="0,15,0,15"/>

                        <TextBlock Text="큐 리스트" FontWeight="SemiBold" FontSize="16" Opacity="0.7" Margin="0,8,0,0"/>
                        <ListView
                            x:Name="QueueList"
                            Height="100"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Opacity="0.3" Margin="0,10"/>

                    <StackPanel Grid.Column="2" Spacing="12">
                        <TextBlock Text="서버 대시보드" FontWeight="Bold" FontSize="16"/>

                        <Grid RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="서버 연결" VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ServerStatusText" Text="확인 중..." FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="총 스캔 수 (30일)" VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TotalScansText" Text="-"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="고위험 탐지" VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HighSeverityText" Text="-" Foreground="Orange"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="치명적 위협" VerticalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CriticalSeverityText" Text="-" Foreground="Red" FontWeight="Bold"/>
                        </Grid>

                        <Button
                            Content="대시보드 새로고침"
                            x:Name="RefreshButton"
                            Click="RefreshDashboard_Click"
                            Width="160"
                            Margin="0,10,0,0"
                            Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>